{
  "expo": {
    "name": "Stillflame",
    "slug": "stillflame",
    "owner": "burdibox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stillflame",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.stillflame.mobile",
      "appleTeamId": "HM348ZXGU4",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "googleServicesFile": "./firebase/GoogleService-Info.plist"
    },
    "android": {
      "package": "app.stillflame.mobile",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0F3D3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./firebase/google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F3D3A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0F3D3A",
          "defaultChannel": "default"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/app-check",
      "./plugins/withUploadSigning",
      "./plugins/withoutAdId",
      "./plugins/withOptionalPortrait",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0"
          },
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8080",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9de2a3bf-8f5e-48d8-b11e-a778e5d4f215"
      }
    }
  }
}
