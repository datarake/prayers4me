PORT=8080
DATABASE_URL=postgres://prayers4me:prayers4me@localhost:5432/prayers4me
# Local auth: send Authorization: Bearer dev:<any-stable-user-id>
AUTH_MODE=dev
# Production: AUTH_MODE=firebase FIREBASE_PROJECT_ID=prayers4me FIREBASE_PROJECT_NUMBER=799342684788 APP_CHECK=enforce
CORS_ORIGIN=http://localhost:3000

# Push notifications: log (print only) or expo (send through Expo's push service)
PUSH_MODE=log

# Abuse protection. Behind Cloud Run set TRUSTED_PROXY_HOPS=1 and a long random IP_HASH_SECRET.
TRUSTED_PROXY_HOPS=0
IP_HASH_SECRET=change-me-to-a-long-random-value
# Local development shares one address, so per-network limits are off here only.
IP_LIMITS=off
NEW_ACCOUNT_PROBATION=off
