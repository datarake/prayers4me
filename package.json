{
  "name": "prayers4me",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @prayers4me/api dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:db": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @prayers4me/api db:migrate",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
